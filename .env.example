# ===== VOC ML – konfigurasi =====
# Salin file ini menjadi .env lalu ubah nilainya.

# Login dashboard admin (WAJIB diganti!)
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Port di host
VOCML_PORT=8080

# Isi true bila dashboard diakses lewat HTTPS (Caddy/Nginx)
COOKIE_SECURE=false

# Opsional: bila diisi, aplikasi Billiard/Kasir POS wajib mengirim header X-VOCML-Key
CLIENT_API_KEY=

# Status "Segera berakhir" bila sisa hari <= nilai ini
EXPIRING_DAYS=7

# Masa toleransi offline (hari) yang dikirim ke aplikasi client
OFFLINE_GRACE_DAYS=5

TZ=Asia/Jakarta
